{
  "name": "lsp-workspace",
  "version": "2.0.12",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run --workspaces build",
    "test": "npm run --workspaces test",
    "lint": "npm run lint:eslint && npm -w @lsp/compiler run lint",
    "lint:eslint": "eslint \"packages/**/*.{ts,mts,cts}\"",
    "clean": "npm run --workspaces clean",
    "typecheck": "npm run --workspaces typecheck",
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/check-version.mjs",
    "r:sync": "node scripts/readme-sync.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "@types/vscode": "^1.144.0",
    "esbuild": "^0.28.2",
    "fast-glob": "^3.3.3",
    "sql-formatter": "^15.9.0"
  }
}
